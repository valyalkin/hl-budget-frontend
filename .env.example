# hl-budget-frontend configuration (contracts/deployment.md). Copy to .env.local for local runs:
#   cp .env.example .env.local
# Next.js reads .env.local in `pnpm dev`; in the cluster these come from the chart and Vault.
# Placeholder values only. Never commit .env.local. There are no NEXT_PUBLIC_* variables.

# Listening port. Not secret. Optional (8080 in the image, 3000 in `pnpm dev`).
PORT=3000
# Public origin of this app; Auth0 callback and logout return here. Not secret. Required.
APP_BASE_URL=http://localhost:3000
# Backend origin, called from the server only. Not secret. Required.
API_BASE_URL=http://localhost:8080
# Abort backend calls after this many milliseconds. Not secret. Optional (default 5000).
API_TIMEOUT_MS=5000
# Auth0 tenant domain. Not secret. Required.
AUTH0_DOMAIN=your-tenant.eu.auth0.com
# Regular Web Application client id. Not secret. Required.
AUTH0_CLIENT_ID=your-client-id
# Regular Web Application client secret. SECRET (Vault kv/apps/hl-budget/frontend). Required.
AUTH0_CLIENT_SECRET=changeme
# Session cookie encryption key. SECRET (Vault). Required. Generate: openssl rand -hex 32
AUTH0_SECRET=generate-with-openssl-rand-hex-32
# Must equal the backend's HLBUDGET_AUTH_AUDIENCE. Not secret. Required.
AUTH0_AUDIENCE=https://api.hl-budget.example
